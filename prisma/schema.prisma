datasource db {
  provider = "sqlite"
  url      = "file:./rooh_business.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("EMPLOYEE") // OWNER, WEBSITE_DEV, STORE_DEV, DESIGNER, CONTENT_EDITOR, SEO_SPECIALIST, BRANCH_MANAGER, EMPLOYEE, DELIVERY_AGENT, SUPPORT, ACCOUNTANT, INVENTORY_MANAGER, CUSTOMER
  branchId     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer       Customer?
  employee       Employee?
  deliveryAgent  DeliveryAgent?
  auditLogs      AuditLog[]
}

model Customer {
  id             String    @id @default(cuid())
  userId         String?   @unique
  name           String
  email          String?
  phone          String
  governorate    String
  city           String
  address        String
  loyaltyPoints  Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id])
  orders         Order[]
  savedAddresses SavedAddress[]
  reviews        ProductReview[]
}

model SavedAddress {
  id          String   @id @default(cuid())
  customerId  String
  title       String   // e.g. "المنزل", "العمل"
  governorate String
  city        String
  street      String
  building    String?
  floor       String?
  apartment   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Employee {
  id              String         @id @default(cuid())
  userId          String         @unique
  nationalId      String?
  title           String
  branchId        String?
  salaryType      String         @default("MONTHLY") // MONTHLY, DAILY, HOURLY
  baseSalary      Float          @default(0)
  commissionRate  Float          @default(0) // e.g. 5%
  hireDate        DateTime       @default(now())
  status          String         @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  branch          Branch?        @relation(fields: [branchId], references: [id])
  salaryRecords   SalaryRecord[]
  commissions     Commission[]
}

model Partner {
  id              String    @id @default(cuid())
  name            String
  contactPerson   String?
  email           String?
  phone           String
  sharePercentage Float     @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
}

model Branch {
  id          String      @id @default(cuid())
  code        String      @unique
  nameAr      String
  nameEn      String
  governorate String
  district    String
  address     String
  phone       String
  managerName String?
  status      String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employees   Employee[]
  warehouses  Warehouse[]
  orders      Order[]
  expenses    Expense[]
}

model Warehouse {
  id          String           @id @default(cuid())
  code        String           @unique
  nameAr      String
  nameEn      String
  branchId    String?
  address     String
  capacity    Int              @default(1000)
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())

  branch      Branch?          @relation(fields: [branchId], references: [id])
  inventory   Inventory[]
  purchaseOrders PurchaseOrder[]
}

model Category {
  id            String     @id @default(cuid())
  slug          String     @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  icon          String?
  imageUrl      String?
  parentId      String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products      Product[]
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  sku             String           @unique
  barcode         String?
  nameAr          String
  nameEn          String
  brand           String           @default("ROOH")
  categoryId      String
  subcategoryId   String?
  shortDescAr     String
  shortDescEn     String
  fullDescAr      String
  fullDescEn      String
  purchaseCost    Float            @default(0)
  sellingPrice    Float            @default(0)
  previousPrice   Float?
  discountPercent Float?
  wholesalePrice  Float?
  status          String           @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isFeatured      Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  isBestSeller    Boolean          @default(false)
  volume          String?          // e.g. 50ml, 100ml
  weight          String?          // e.g. 150g
  skinType        String?          // e.g. جميع أنواع البشرة
  hairType        String?          // e.g. للشعر الجاف والتالف
  ingredientsAr   String?
  ingredientsEn   String?
  instructionsAr  String?
  warningsAr      String?
  countryOfOrigin String           @default("مصر - تصنيع رُوح للجمال")
  batchNumber     String?
  expirationDate  DateTime?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  inventory       Inventory[]
  orderItems      OrderItem[]
  reviews         ProductReview[]
  stockMovements  StockMovement[]
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  sku         String      @unique
  nameAr      String
  nameEn      String
  size        String?
  color       String?
  fragrance   String?
  price       Float
  stock       Int         @default(0)
  imageUrl    String?

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id               String          @id @default(cuid())
  productId        String
  variantId        String?
  warehouseId      String
  quantity         Int             @default(0)
  reservedQuantity Int             @default(0)
  minAlertStock    Int             @default(5)
  updatedAt        DateTime        @updatedAt

  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])
}

model StockMovement {
  id              String    @id @default(cuid())
  productId       String
  variantId       String?
  fromWarehouseId String?
  toWarehouseId   String?
  quantity        Int
  movementType    String    // INCOMING, OUTGOING, TRANSFER, ADJUSTMENT
  reference       String?
  notes           String?
  createdByName   String?
  createdAt       DateTime  @default(now())

  product         Product   @relation(fields: [productId], references: [id])
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  customerId        String?
  customerName      String
  customerEmail     String?
  customerPhone     String
  governorate       String
  city              String
  address           String
  subtotal          Float
  shippingFee       Float
  discountAmount    Float          @default(0)
  codFee            Float          @default(0)
  totalAmount       Float
  paymentMethod     String         // COD, VODAFONE_CASH, ORANGE_CASH, ETISALAT_CASH, WE_PAY, CARD, PAYMOB
  paymentStatus     String         @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus       String         @default("NEW") // NEW, PENDING_CONFIRMATION, CONFIRMED, PREPARING, READY_FOR_DISPATCH, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED
  branchId          String?
  deliveryAgentId   String?
  paymentReceiptUrl String?
  notes             String?
  invoiceNumber     String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customer          Customer?      @relation(fields: [customerId], references: [id])
  branch            Branch?        @relation(fields: [branchId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  deliveryOrder     DeliveryOrder?
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  productNameAr String
  productNameEn String
  variantName   String?
  quantity      Int
  unitPrice     Float
  purchaseCost  Float    @default(0)
  totalPrice    Float

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String?
  amount         Float
  currency       String    @default("EGP")
  method         String
  status         String    @default("PENDING") // PENDING, VERIFIED, FAILED, REFUNDED
  transactionRef String?
  proofImageUrl  String?
  verifiedBy     String?
  verifiedAt     DateTime?
  fee            Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  order          Order?    @relation(fields: [orderId], references: [id])
  refunds        Refund[]
}

model Refund {
  id          String    @id @default(cuid())
  orderId     String
  paymentId   String?
  amount      Float
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  requestedBy String
  approvedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())

  order       Order     @relation(fields: [orderId], references: [id])
  payment     Payment?  @relation(fields: [paymentId], references: [id])
}

model ShippingZone {
  id                     String   @id @default(cuid())
  governorate            String   @unique
  governorateAr          String
  deliveryFee            Float
  estimatedDays          String   @default("2-3 أيام عمل")
  freeShippingThreshold  Float?
  isActive               Boolean  @default(true)
}

model DeliveryAgent {
  id                String          @id @default(cuid())
  userId            String          @unique
  vehicleType       String?         // دراجة نارية، سيارة
  licenseNumber     String?
  activeOrdersCount Int             @default(0)
  status            String          @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE

  user              User            @relation(fields: [userId], references: [id])
  deliveryOrders    DeliveryOrder[]
}

model DeliveryOrder {
  id             String        @id @default(cuid())
  orderId        String        @unique
  agentId        String?
  assignedAt     DateTime      @default(now())
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  deliveryStatus String        @default("ASSIGNED") // ASSIGNED, PICKED_UP, OUT_FOR_DELIVERY, DELIVERED, FAILED
  cashCollected  Float         @default(0)
  notes          String?

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent          DeliveryAgent? @relation(fields: [agentId], references: [id])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  company        String
  contactName    String?
  phone          String
  email          String?
  address        String?
  balance        Float           @default(0)
  notes          String?
  createdAt      DateTime        @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  warehouseId String
  totalCost   Float               @default(0)
  status      String              @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float
  totalCost       Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String    @id @default(cuid())
  title       String
  category    String    // RENT, UTILITIES, MARKETING, SALARY, SHIPPING, PACKAGING, MAINTENANCE, OTHER
  amount      Float
  currency    String    @default("EGP")
  branchId    String?
  date        DateTime  @default(now())
  description String?
  receiptUrl  String?
  approvedBy  String?
  createdAt   DateTime  @default(now())

  branch      Branch?   @relation(fields: [branchId], references: [id])
}

model SalaryRecord {
  id               String          @id @default(cuid())
  employeeId       String
  periodMonth      Int
  periodYear       Int
  baseSalary       Float
  commissionAmount Float           @default(0)
  bonusAmount      Float           @default(0)
  allowanceAmount  Float           @default(0)
  deductionAmount  Float           @default(0)
  advanceDeduction Float           @default(0)
  netSalary        Float
  status           String          @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, PAID
  createdAt        DateTime        @default(now())

  employee         Employee        @relation(fields: [employeeId], references: [id])
  payments         SalaryPayment[]
}

model SalaryPayment {
  id             String       @id @default(cuid())
  salaryRecordId String
  amount         Float
  paymentMethod  String       // BANK_TRANSFER, CASH, WALLET
  paymentDate    DateTime     @default(now())
  reference      String?
  paidBy         String?
  notes          String?

  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id])
}

model Commission {
  id              String    @id @default(cuid())
  employeeId      String
  orderId         String?
  amount          Float
  calculationType String    @default("PERCENTAGE")
  status          String    @default("PENDING") // PENDING, APPROVED, PAID
  createdAt       DateTime  @default(now())

  employee        Employee  @relation(fields: [employeeId], references: [id])
}

model ApprovalRequest {
  id              String    @id @default(cuid())
  requestType     String    // REFUND, EXPENSE, PRICE_CHANGE, SALARY_CHANGE, STOCK_ADJUSTMENT, DELETE_RECORD, CRITICAL_SETTINGS
  targetEntity    String
  targetEntityId  String?
  previousValue   String?
  proposedValue   String?
  financialImpact Float?
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  requestedByName String
  approvedByName  String?
  reviewNotes     String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
}

model Conversation {
  id            String    @id @default(cuid())
  customerId    String?
  customerName  String
  customerPhone String?
  type          String    @default("CUSTOMER_SUPPORT") // CUSTOMER_SUPPORT, INTERNAL_TEAM
  status        String    @default("OPEN") // OPEN, ASSIGNED, RESOLVED, CLOSED
  assignedToName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderType      String       // CUSTOMER, AGENT, OWNER, SYSTEM
  senderName      String
  messageText     String
  messageType     String       @default("TEXT") // TEXT, AUDIO, IMAGE, ATTACHMENT
  mediaUrl        String?
  durationSeconds Int?
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   // ORDER, STOCK, APPROVAL, SYSTEM, MESSAGE
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model WebsitePage {
  id             String   @id @default(cuid())
  slug           String   @unique
  titleAr        String
  titleEn        String
  contentJson    String   // Rich section JSON definition
  isPublished    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model StorePage {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleAr     String
  titleEn     String
  layoutJson  String   // Layout sections and banner widgets
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model DesignToken {
  id        String   @id @default(cuid())
  themeName String   @unique
  tokens    String   // JSON of CSS vars, fonts, borders, botanical settings
  isDefault Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  fileName   String
  fileUrl    String
  fileType   String   // IMAGE, AUDIO, VIDEO, DOCUMENT
  fileSize   Int
  mimeType   String
  folder     String   @default("general")
  altText    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  authorName String
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  entity      String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model AISetting {
  id                  String   @id @default(cuid())
  assistantType       String   @unique // OWNER_ASSISTANT, CUSTOMER_SUPPORT, VISUAL_DESIGNER
  name                String
  welcomeMessageAr    String
  welcomeMessageEn    String
  tone                String   @default("LUXURY_PROFESSIONAL")
  isEnabled           Boolean  @default(true)
  knowledgeConfigJson String?
  updatedAt           DateTime @updatedAt
}

model SystemSetting {
  key         String   @id
  value       String   // JSON or text
  description String?
  updatedAt   DateTime @updatedAt
}

